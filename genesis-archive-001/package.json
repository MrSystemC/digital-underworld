{
  "name": "genesis-archive-001",
  "version": "1.0.0",
  "private": true,
  "description": "One-of-one ERC-721 release package for GENESIS ARCHIVE #001",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "metadata:finalize": "node scripts/finalize-metadata.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network ethereum",
    "mint:sepolia": "hardhat run scripts/mint.js --network sepolia",
    "mint:mainnet": "hardhat run scripts/mint.js --network ethereum",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "verify:mainnet": "hardhat run scripts/verify.js --network ethereum"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "hardhat": "2.22.18"
  },
  "engines": { "node": ">=20 <23" }
}